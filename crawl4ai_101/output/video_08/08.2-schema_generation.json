{
  "name": "Wikipedia Article Contents",
  "baseSelector": "main h1",
  "fields": [
    {
      "name": "page_title",
      "selector": "h1",
      "type": "text"
    },
    {
      "exports": "list of the main pages content for each section header",
      "selector": "nav[class*='Table of Contents'] ul li a",
      "type": "list",
      "fields": [
        {
          "name": "section_title",
          "selector": "div",
          "type": "text"
        },
        {
          "name": "section_link",
          "selector": "a",
          "type": "attribute",
          "attribute": "href"
        }
      ]
    }
  ]
}