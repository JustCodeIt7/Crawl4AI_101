{
  "name": "Documentation Page Content",
  "baseSelector": "section#mkdocs-terminal-content",
  "fields": [
    {
      "name": "page_title",
      "selector": "h1#getting-started-with-crawl4ai",
      "type": "text"
    },
    {
      "name": "sections",
      "type": "list",
      "selector": "h2[id]",
      "fields": [
        {
          "name": "heading",
          "selector": ":scope",
          "type": "text"
        },
        {
          "name": "id",
          "selector": ":scope",
          "type": "attribute",
          "attribute": "id"
        }
      ]
    },
    {
      "name": "code_blocks",
      "type": "list",
      "selector": "div.highlight pre code",
      "fields": [
        {
          "name": "code",
          "selector": ":scope",
          "type": "text"
        },
        {
          "name": "language",
          "selector": ":scope",
          "type": "attribute",
          "attribute": "class"
        },
        {
          "name": "highlighted",
          "selector": ":scope",
          "type": "attribute",
          "attribute": "data-highlighted"
        }
      ]
    }
  ]
}