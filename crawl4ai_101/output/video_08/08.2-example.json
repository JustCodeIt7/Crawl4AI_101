{
  "name": "Wikipedia Article Content",
  "baseSelector": "main",
  "fields": [
    {
      "name": "page_title",
      "selector": "h1",
      "type": "text"
    },
    {
      "name": -1,
      "selector": ".toc",
      "type": "list",
      "fields": [
        {
          "name": "section_title",
          "selector": "li a",
          "type": "text"
        }
      ]
    },
    {
      "name": "sections",
      "selector": "div[id^='']",
      "type": "list",
      "fields": [
        {
          "name": "section_header",
          "section_header": "h2, h3",
          "type": "text"
        }
      ]
    }
  ]
}